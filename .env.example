# Copy this file to .env and add your Gemini API key locally.
GEMINI_API_KEY=

# Optional Society message translation API provider. Create a Google Cloud
# Translation API key with the Cloud Translation API enabled.
GOOGLE_TRANSLATE_API_KEY=

# Optional model overrides
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
